{
  "name": "tjp-website-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/server.js",
    "test": "tsx --test test/*.test.ts",
    "admin:create": "tsx src/admin-cli.ts",
    "admin:recover": "tsx src/admin-cli.ts recover",
    "setup:local": "node scripts/setup-local.mjs",
    "docs:api": "tsx scripts/openapi.ts",
    "keys:rotate": "tsx src/rotate-keys.ts",
    "locations:check": "tsx scripts/check-locations.ts"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "i18n-iso-countries": "^7.14.0",
    "jose": "^6.2.13",
    "libphonenumber-js": "^1.13.15",
    "mongoose": "^9.11.1",
    "otpauth": "^9.5.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
